[Unit]
Description=Gunicorn server for SITENAME

[Service]
Restart=on-failure
User=yyy
WorkingDirectory=/home/yyy/sites/SITENAME/source/mywebsite
ExecStart=/home/yyy/sites/SITENAME/virtualenv/bin/gunicorn \
    --bind unix:/tmp/SITENAME.socket \
    mywebsite.wsgi:application

[Install]
WantedBy=multi-user.target
